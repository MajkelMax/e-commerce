@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - e_commerce</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/e_commerce.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="bi bi-shop" style="font-size: 2rem; color: #198754; margin-right: 0.5rem;"></span>
                    <span class="fw-bold" style="font-size: 1.5rem;">e-commerce</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Przełącz nawigację">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Categories" asp-action="Index">
                                    <span class="bi bi-list"></span> Kategorie
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Brands" asp-action="Index">
                                    <span class="bi bi-tags"></span> Marki
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">
                                <span class="bi bi-box-seam"></span> Produkty
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link position-relative" href="#" title="Koszyk" data-bs-toggle="modal" data-bs-target="#basketModal" id="basketIcon">
                                    <span class="bi bi-basket" style="font-size: 1.7rem; vertical-align: middle;"></span>
                                    <span class="visually-hidden">Koszyk</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <partial name="_LoginPartial" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - e_commerce - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div class="modal fade" id="basketModal" tabindex="-1" aria-labelledby="basketModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-md">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="basketModalLabel">Your Basket</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="basketModalBody">
                    <div class="text-center">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="@Url.Action("Index", "Basket")" class="btn btn-primary w-100">Przejdź do koszyka</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var basketModal = document.getElementById('basketModal');
            var modalBody = document.getElementById('basketModalBody');

            function reloadBasketPopup() {
                fetch('@Url.Action("Popup", "Basket")')
                    .then(response => response.text())
                    .then(html => {
                        modalBody.innerHTML = html;
                        attachBasketAjaxHandlers();
                    });
            }

            function attachBasketAjaxHandlers() {
                // Update quantity
                modalBody.querySelectorAll('.basket-update-form').forEach(function (form) {
                    form.onsubmit = function (e) {
                        e.preventDefault();
                        var productId = form.getAttribute('data-product-id');
                        var quantity = form.querySelector('input[name="quantity"]').value;
                        fetch('@Url.Action("UpdateAjax", "Basket")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `productId=${productId}&quantity=${quantity}`
                        })
                        .then(response => response.text())
                        .then(html => {
                            modalBody.innerHTML = html;
                            attachBasketAjaxHandlers();
                        });
                    };
                });

                // Remove item
                modalBody.querySelectorAll('.basket-remove-form').forEach(function (form) {
                    form.onsubmit = function (e) {
                        e.preventDefault();
                        var productId = form.getAttribute('data-product-id');
                        fetch('@Url.Action("RemoveAjax", "Basket")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `productId=${productId}`
                        })
                        .then(response => response.text())
                        .then(html => {
                            modalBody.innerHTML = html;
                            attachBasketAjaxHandlers();
                        });
                    };
                });

                // Clear basket
                var clearForm = modalBody.querySelector('.basket-clear-form');
                if (clearForm) {
                    clearForm.onsubmit = function (e) {
                        e.preventDefault();
                        fetch('@Url.Action("ClearAjax", "Basket")', {
                            method: 'POST'
                        })
                        .then(response => response.text())
                        .then(html => {
                            modalBody.innerHTML = html;
                            attachBasketAjaxHandlers();
                        });
                    };
                }
            }

            basketModal.addEventListener('show.bs.modal', function () {
                modalBody.innerHTML = '<div class="text-center"><div class="spinner-border" role="status"></div></div>';
                reloadBasketPopup();
            });
        });
    </script>

</body>
</html>
