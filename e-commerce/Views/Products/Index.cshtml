@model IEnumerable<e_commerce.Models.Product>

@{
    ViewData["Title"] = "Produkty";
}

<h1>Produkty w ofercie</h1>

<p>
    <a asp-action="Create">Stwórz nowy produkt</a>
</p>

<!-- Formularz wyszukiwania i sortowania -->
<div class="row mb-3">
    <div class="col-md-6">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" class="form-control" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Szukaj produktów..." />
                <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i> Szukaj
                </button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["CurrentSort"]" class="btn btn-secondary">Wyczyść</a>
                }
            </div>
        </form>
    </div>
    <div class="col-md-6">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="hidden" name="searchString" value="@ViewData["CurrentFilter"]" />
                <label class="input-group-text" for="sortOrder">Sortuj według:</label>
                <select class="form-select" name="sortOrder" id="sortOrder" onchange="this.form.submit()">
                    @{
                        var currentSort = ViewData["CurrentSort"]?.ToString() ?? "";
                    }
                    @if (string.IsNullOrEmpty(currentSort))
                    {
                        <option value="" selected>Nazwa (A-Z)</option>
                    }
                    else
                    {
                        <option value="">Nazwa (A-Z)</option>
                    }
                    @if (currentSort == "name_desc")
                    {
                        <option value="name_desc" selected>Nazwa (Z-A)</option>
                    }
                    else
                    {
                        <option value="name_desc">Nazwa (Z-A)</option>
                    }
                    @if (currentSort == "price_asc")
                    {
                        <option value="price_asc" selected>Cena (rosnąco)</option>
                    }
                    else
                    {
                        <option value="price_asc">Cena (rosnąco)</option>
                    }
                    @if (currentSort == "price_desc")
                    {
                        <option value="price_desc" selected>Cena (malejąco)</option>
                    }
                    else
                    {
                        <option value="price_desc">Cena (malejąco)</option>
                    }
                    @if (currentSort == "date_asc")
                    {
                        <option value="date_asc" selected>Data dodania (najstarsze)</option>
                    }
                    else
                    {
                        <option value="date_asc">Data dodania (najstarsze)</option>
                    }
                    @if (currentSort == "date_desc")
                    {
                        <option value="date_desc" selected>Data dodania (najnowsze)</option>
                    }
                    else
                    {
                        <option value="date_desc">Data dodania (najnowsze)</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-searchString="@ViewData["CurrentFilter"]">
                    @Html.DisplayNameFor(model => model.Name)
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ShortDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sku)
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParam"]" asp-route-searchString="@ViewData["CurrentFilter"]">
                    @Html.DisplayNameFor(model => model.Price)
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SalePrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StockQuantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsPublished)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Brand)
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]" asp-route-searchString="@ViewData["CurrentFilter"]">
                    @Html.DisplayNameFor(model => model.CreatedDate)
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ShortDescription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sku)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SalePrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StockQuantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsPublished)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ImageUrl)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Brand.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedDate)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edytuj</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detale</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
                    <form asp-controller="Basket" asp-action="Add" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <input type="number" name="quantity" value="1" min="1" max="@item.StockQuantity" style="width: 60px;" class="form-control d-inline" />
                        <button type="submit" class="btn btn-sm btn-success">
                            <span class="bi bi-basket"></span> Dodaj do koszyka
                        </button>
                    </form>
            </td>
        </tr>
}
    </tbody>
</table>
<br></br>
<h2>Produkty</h2>
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" asp-route-searchString="@ViewData["CurrentFilter"]">
                    Nazwa produktu
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSortParam"]" asp-route-searchString="@ViewData["CurrentFilter"]">
                    Cena
                </a>
            </th>
            <th>Ilość w magazynie</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model)
    {
        <tr>
            <td>@product.Name</td>
            <td>@product.Price.ToString("C")</td>
            <td>@product.StockQuantity</td>
            <td>
                <form asp-controller="Basket" asp-action="Add" method="post" class="d-inline">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <input type="number" name="quantity" value="1" min="1" max="@product.StockQuantity" style="width: 60px;" class="form-control d-inline" />
                    <button type="submit" class="btn btn-sm btn-success">
                        <span class="bi bi-basket"></span> Dodaj do koszyka
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
