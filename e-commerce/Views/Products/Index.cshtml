@model IEnumerable<e_commerce.Models.Product>
@using System.Globalization

@{
    ViewData["Title"] = "Produkty";
    var currentSort = ViewData["CurrentSort"]?.ToString() ?? "";
}

<h1 class="mb-4">Produkty w ofercie</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">Stwórz nowy produkt</a>
</p>

<!-- Search and sort forms -->
<div class="row mb-4">
    <div class="col-md-6">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" class="form-control" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Szukaj produktów..." />
                <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
                <button class="btn btn-primary" type="submit">
                    <i class="bi bi-search"></i> Szukaj
                </button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["CurrentSort"]" class="btn btn-secondary">Wyczyść</a>
                }
            </div>
        </form>
    </div>
    <div class="col-md-6">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="hidden" name="searchString" value="@ViewData["CurrentFilter"]" />
                <label class="input-group-text" for="sortOrder">Sortuj według:</label>
                <select class="form-select" name="sortOrder" id="sortOrder" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(currentSort) ? "selected" : null)">Nazwa (A-Z)</option>
                    <option value="name_desc" selected="@(currentSort == "name_desc" ? "selected" : null)">Nazwa (Z-A)</option>
                    <option value="price_asc" selected="@(currentSort == "price_asc" ? "selected" : null)">Cena (rosnąco)</option>
                    <option value="price_desc" selected="@(currentSort == "price_desc" ? "selected" : null)">Cena (malejąco)</option>
                    <option value="date_asc" selected="@(currentSort == "date_asc" ? "selected" : null)">Data dodania (najstarsze)</option>
                    <option value="date_desc" selected="@(currentSort == "date_desc" ? "selected" : null)">Data dodania (najnowsze)</option>
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Product card grid -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                    <div class="ratio ratio-1x1 bg-light d-flex align-items-center justify-content-center" style="overflow: hidden;">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 class="card-img-top img-fluid"
                                 alt="@item.Name"
                                 style="object-fit: contain; width: 100%; height: 100%;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center w-100 h-100 text-muted">
                                <span>Brak obrazka</span>
                            </div>
                        }
                    </div>

                    <div class="px-3 pt-2 pb-0">
                        <p class="card-text text-muted" style="min-height: 3em;">@item.ShortDescription</p>
                    </div>
                    <div class="card-body d-flex flex-column pt-0">
                        <h5 class="card-title">@item.Name</h5>
                        <div class="mb-2">
                            @if (item.SalePrice > 0 && item.SalePrice < item.Price)
                            {
                                <span class="fw-bold text-danger" style="font-size: 1.2em;">
                                    @item.SalePrice.ToString("C", new CultureInfo("pl-PL"))
                                </span>
                                <span class="text-muted ms-2" style="text-decoration: line-through;">
                                    @item.Price.ToString("C", new CultureInfo("pl-PL"))
                                </span>
                            }
                            else
                            {
                                <span class="fw-bold text-success" style="font-size: 1.2em;">
                                    @item.Price.ToString("C", new CultureInfo("pl-PL"))
                                </span>
                            }
                        </div>
                    </div>
                </a>
                <div class="card-body d-flex flex-column pt-0">
                    <div class="mb-2">
                        <span class="badge bg-secondary">@item.Category?.Name</span>
                        @if (item.Brand != null)
                        {
                            <span class="badge bg-light text-dark border ms-1">@item.Brand.Name</span>
                        }
                    </div>
                    <div class="mt-auto">
                        <form asp-controller="Basket" asp-action="Add" method="post" class="d-flex align-items-center gap-2">
                            <input type="hidden" name="productId" value="@item.Id" />
                            <input type="number" name="quantity" value="1" min="1" max="@item.StockQuantity" class="form-control form-control-sm" style="width: 70px;" />
                            <button type="submit" class="btn btn-success btn-sm flex-shrink-0">
                                <span class="bi bi-basket"></span> Do koszyka
                            </button>
                        </form>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 d-flex justify-content-between">
                    @* <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-link btn-sm p-0">Detale</a> *@
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-link btn-sm p-0">Edytuj</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-link btn-sm text-danger p-0">Usuń</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .card-title {
        min-height: 2.5em;
    }

    .ratio.ratio-1x1 {
        width: 100%;
        height: 200px;
        position: relative;
    }

    .card-img-top.img-fluid {
        object-fit: contain;
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
    }

</style>
