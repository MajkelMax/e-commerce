@model e_commerce.Models.Basket
@{
    ViewData["Title"] = "Twój koszyk";
}
<h2>Twój koszyk</h2>
<table class="table">
    <thead>
        <tr>
            <th>Produkt</th>
            <th>Ilość</th>
            <th>Cena</th>
            <th>Total</th>
            <th>Razem</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>
                    <form asp-action="Update" asp-controller="Basket" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control d-inline" style="width: 80px;" />
                        <button type="submit" class="btn btn-sm btn-primary">Update</button>
                    </form>
                </td>
                <td>@item.Product.Price.ToString("C")</td>
                <td>@((item.Product.Price * item.Quantity).ToString("C"))</td>
                <td>
                    <form asp-action="Remove" asp-controller="Basket" method="post" class="d-inline">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <button type="submit" class="btn btn-sm btn-danger">Usuń</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (TempData["Error"] != null) 
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null) 
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
<form asp-action="ApplyDiscount" asp-controller="Basket" method="post" class="d-inline">
    <input type="text" name="discountCode" class="form-control d-inline" placeholder="Kod rabatowy" />
    <button type="submit" class="btn btn-primary">Zastosuj rabat</button> <br />
</form>
<form asp-action="Clear" asp-controller="Basket" method="post" class="d-inline">
    <button type="submit" class="btn btn-warning">Wyczyść koszyk</button><br />
</form>
<form asp-action="SubmitOrder" asp-controller="Basket" method="post" class="d-inline">
    <button type="submit" class="btn btn-success">Złóż zamówienie</button>
</form>
